<Window x:Class="MineDock.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MineDock.App"
 Title="MineDock" Width="1340" Height="860" MinWidth="1080" MinHeight="740"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}"
 Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
 WindowStyle="None" ResizeMode="CanResize" Loaded="OnLoaded" Closing="OnClosing">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="0"/></WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="Nav" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Margin" Value="10,2"/>
   <Setter Property="Height" Value="44"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="B" Background="Transparent" CornerRadius="6" Padding="15,0"><ContentPresenter VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value=".75"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
  <Style x:Key="BackgroundSlider" TargetType="Slider">
   <Setter Property="Height" Value="28"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid Background="Transparent">
     <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
      <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource AccentBrush}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb Width="16" Height="22"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Width="14" Height="14" Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource SidebarBrush}" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource BorderBrush}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
     </Track>
     <Border x:Name="FocusFrame" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="4" Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusFrame" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Image x:Name="WindowBackground" Grid.Row="1" Source="{Binding BackgroundImage}" Stretch="{Binding BackgroundStretch}"
         Opacity="{Binding BackgroundOpacity}" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
  <Grid Background="{DynamicResource SidebarBrush}">
   <StackPanel Orientation="Horizontal" Margin="18,0">
    <local:Icon Kind="box" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}"/>
    <TextBlock Text="MineDock" Margin="9,0,12,0" FontWeight="SemiBold" FontSize="12"/>
    <TextBlock Text="0.1.1" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,5,0">
    <Button x:Name="BackgroundSettingsButton" Style="{StaticResource IconButton}" Click="OpenBackgroundSettings" ToolTip="自定义背景" AutomationProperties.Name="自定义背景"><local:Icon Kind="image" Width="16" Height="16" Foreground="{DynamicResource MutedBrush}"/></Button>
    <Button Style="{StaticResource IconButton}" Click="ToggleTheme" ToolTip="切换明暗主题"><local:Icon Kind="sun" Width="16" Height="16" Foreground="{DynamicResource MutedBrush}"/></Button>
    <Button Style="{StaticResource IconButton}" Click="Minimize" ToolTip="最小化"><TextBlock Text="&#x2212;" FontSize="18"/></Button>
    <Button Style="{StaticResource IconButton}" Click="Maximize" ToolTip="最大化 / 还原"><local:Icon Kind="square" Width="13" Height="13" Foreground="{DynamicResource MutedBrush}"/></Button>
    <Button Style="{StaticResource IconButton}" Click="CloseWindow" ToolTip="关闭"><local:Icon Kind="x" Width="17" Height="17" Foreground="{DynamicResource MutedBrush}"/></Button>
   </StackPanel>
   <Popup x:Name="BackgroundPopup" PlacementTarget="{Binding ElementName=BackgroundSettingsButton}" Placement="Bottom"
          StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-308">
    <Border Width="336" Margin="0,6,8,8" Padding="20" Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
     <StackPanel>
      <Grid Margin="0,0,0,16">
       <TextBlock Text="自定义背景" FontSize="16" FontWeight="SemiBold"/>
       <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Width="26" Height="26" MinHeight="26" Padding="5" Click="CloseBackgroundSettings" ToolTip="关闭背景设置"><local:Icon Kind="x" Width="16" Height="16" Foreground="{DynamicResource MutedBrush}"/></Button>
      </Grid>
      <Border Height="142" Background="{DynamicResource BackgroundBrush}" CornerRadius="6" ClipToBounds="True">
       <Grid>
        <Image Source="{Binding BackgroundImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasBackground, Converter={StaticResource NotVisibility}}">
         <local:Icon Kind="image" Width="30" Height="30" Foreground="{DynamicResource MutedBrush}"/>
         <TextBlock Text="未设置背景" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,9,0,0"/>
        </StackPanel>
       </Grid>
      </Border>
      <TextBlock Text="{Binding BackgroundName}" ToolTip="{Binding BackgroundName}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,10,0,15"/>
      <Grid IsEnabled="{Binding CanChangeBackground}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Button Click="ChooseBackground"><StackPanel Orientation="Horizontal"><local:Icon Kind="folder-open" Width="15" Height="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0"/><TextBlock Text="选择图片" FontSize="12"/></StackPanel></Button>
       <Button Grid.Column="2" Click="ResetBackground"><StackPanel Orientation="Horizontal"><local:Icon Kind="refresh-cw" Width="15" Height="15" Foreground="{DynamicResource MutedBrush}" Margin="0,0,7,0"/><TextBlock Text="恢复默认" FontSize="12"/></StackPanel></Button>
      </Grid>
      <Grid Margin="0,22,0,6"><TextBlock Text="背景强度" FontSize="12"/><TextBlock Text="{Binding BackgroundPercent}" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></Grid>
      <Slider x:Name="BackgroundIntensitySlider" Style="{StaticResource BackgroundSlider}" Minimum="0" Maximum="1" SmallChange=".05" LargeChange=".1"
              Value="{Binding BackgroundIntensity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              ValueChanged="BackgroundIntensityChanged" IsEnabled="{Binding HasBackground}" AutomationProperties.Name="背景强度"/>
      <TextBlock Text="图片布局" FontSize="12" Margin="0,16,0,8"/>
      <ComboBox x:Name="BackgroundStretchCombo" ItemsSource="{Binding BackgroundStretchChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                SelectedValue="{Binding BackgroundStretch}" SelectionChanged="BackgroundStretchChanged" IsEnabled="{Binding HasBackground}"/>
      <TextBlock Text="{Binding BackgroundError}" FontSize="11" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
     </StackPanel>
    </Border>
   </Popup>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="*"/><RowDefinition Height="184"/></Grid.RowDefinitions>
     <StackPanel Margin="26,20,20,0">
      <TextBlock Text="MineDock" FontSize="25" FontWeight="SemiBold"/>
      <TextBlock Text="MINECRAFT · JAVA" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="1,6,0,0"/>
     </StackPanel>
     <StackPanel Grid.Row="1">
      <TextBlock Text="资源库" Style="{StaticResource Caption}" Margin="27,6,0,10"/>
      <RadioButton x:Name="NavGame" Style="{StaticResource Nav}" Tag="Game" GroupName="Nav" IsChecked="True" Checked="Navigate"><StackPanel Orientation="Horizontal"><local:Icon Kind="blocks" Width="19" Height="19" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="游戏" Margin="13,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
      <RadioButton x:Name="NavModpack" Style="{StaticResource Nav}" Tag="Modpack" GroupName="Nav" Checked="Navigate"><StackPanel Orientation="Horizontal"><local:Icon Kind="package" Width="19" Height="19" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="整合包" Margin="13,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
      <RadioButton x:Name="NavMod" Style="{StaticResource Nav}" Tag="Mod" GroupName="Nav" Checked="Navigate"><StackPanel Orientation="Horizontal"><local:Icon Kind="puzzle" Width="19" Height="19" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="模组" Margin="13,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
      <RadioButton x:Name="NavShader" Style="{StaticResource Nav}" Tag="Shader" GroupName="Nav" Checked="Navigate"><StackPanel Orientation="Horizontal"><local:Icon Kind="sparkles" Width="19" Height="19" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="光影" Margin="13,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
      <RadioButton x:Name="NavResourcepack" Style="{StaticResource Nav}" Tag="Resourcepack" GroupName="Nav" Checked="Navigate"><StackPanel Orientation="Horizontal"><local:Icon Kind="image" Width="19" Height="19" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="材质包" Margin="13,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
      <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="26,18"/>
      <RadioButton x:Name="NavJava" Style="{StaticResource Nav}" Tag="Java" GroupName="Nav" Checked="Navigate"><StackPanel Orientation="Horizontal"><local:Icon Kind="coffee" Width="19" Height="19" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="Java" Margin="13,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
      <RadioButton x:Name="NavTasks" Style="{StaticResource Nav}" Tag="Tasks" GroupName="Nav" Checked="Navigate"><StackPanel Orientation="Horizontal"><local:Icon Kind="download" Width="19" Height="19" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="下载任务" Margin="13,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
     </StackPanel>
     <StackPanel Grid.Row="2" Margin="20,12,20,14" VerticalAlignment="Bottom">
      <TextBlock Text="游戏来源" Style="{StaticResource Caption}"/>
      <ComboBox ItemsSource="{Binding SourceChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SourceValue}" SelectionChanged="SourceChanged" FontSize="11" IsEnabled="{Binding CanPrepare}"/>
      <Button Click="AssociatePcl" ToolTip="{Binding PclTooltip}" Margin="0,12,0,0" HorizontalContentAlignment="Left">
       <StackPanel Orientation="Horizontal"><local:Icon Kind="external-link" Width="15" Height="15" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding PclLabel}" Margin="9,0,0,0" FontSize="12"/></StackPanel>
      </Button>
      <TextBlock Text="BMCLAPI · Mojang · Modrinth" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,13,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="85"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="77"/></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="26,14">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="285"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="目标目录" Style="{StaticResource Caption}"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding RootLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RootLabel}" FontSize="12"/>
        <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="ChooseRoot" ToolTip="选择 .minecraft 文件夹" Margin="0,-5,0,-5"><local:Icon Kind="folder-open" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}"/></Button>
       </Grid>
      </StackPanel>
      <StackPanel Grid.Column="2">
       <TextBlock Text="当前游戏版本" Style="{StaticResource Caption}"/>
       <ComboBox ItemsSource="{Binding Instances}" DisplayMemberPath="Display" SelectedItem="{Binding Target}" SelectionChanged="TargetChanged" FontSize="11" ToolTip="{Binding TargetDirectory}" MinHeight="31" Padding="9,5,28,5"/>
      </StackPanel>
      <Button Grid.Column="3" Style="{StaticResource IconButton}" Click="RefreshInstances" ToolTip="刷新本地版本" Margin="5,14,0,0"><local:Icon Kind="refresh-cw" Width="17" Height="17" Foreground="{DynamicResource MutedBrush}"/></Button>
     </Grid>
    </Border>
    <Border Grid.Row="1" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="3,0,0,0" Padding="14,10" Margin="26,14,26,0">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" FontSize="12"/>
      <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="26" Height="26" MinHeight="26" Padding="6" Click="DismissError" ToolTip="关闭提示"><local:Icon Kind="x" Foreground="{DynamicResource MutedBrush}"/></Button>
     </Grid>
    </Border>
    <Grid Grid.Row="2" Margin="26,24,26,18">
     <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid>
      <StackPanel>
       <TextBlock Text="{Binding PageEyebrow}" Style="{StaticResource Caption}" FontSize="10"/>
       <TextBlock Text="{Binding PageTitle}" FontSize="25" FontWeight="SemiBold"/>
      </StackPanel>
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
       <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" FontSize="12" MaxWidth="320" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
       <Button Style="{StaticResource IconButton}" Click="RefreshPage" ToolTip="刷新当前栏目"><local:Icon Kind="refresh-cw" Width="17" Height="17" Foreground="{DynamicResource MutedBrush}"/></Button>
      </StackPanel>
     </Grid>
     <Grid Grid.Row="1" Visibility="{Binding IsGame, Converter={StaticResource BoolVisibility}}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="35"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions>
        <Grid><TextBox x:Name="GameSearch" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" TextChanged="GameSearchChanged" Padding="35,8,10,8" AutomationProperties.Name="搜索游戏版本"/><local:Icon Kind="search" Width="16" Height="16" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False"/></Grid>
        <ComboBox Grid.Column="2" ItemsSource="{Binding InstalledChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding InstalledFilter}" SelectionChanged="GameSearchChanged"/>
       </Grid>
       <Grid Grid.Row="1" Margin="13,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="版本" Style="{StaticResource Caption}" Margin="0"/><TextBlock Grid.Column="1" Text="发布日期" Style="{StaticResource Caption}" Margin="0"/><TextBlock Grid.Column="2" Text="状态" Style="{StaticResource Caption}" Margin="0"/></Grid>
       <ListBox Grid.Row="2" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" SelectionChanged="GameSelected" AutomationProperties.Name="Minecraft 正式版本">
        <ListBox.ItemTemplate><DataTemplate><Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
         <StackPanel Orientation="Horizontal"><local:Icon Kind="box" Width="17" Height="17" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0"/><TextBlock Text="{Binding Id}" FontWeight="SemiBold"/></StackPanel>
         <TextBlock Grid.Column="1" Text="{Binding Date}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
         <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
        </Grid></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <TextBlock Grid.Row="2" Text="没有匹配的游戏版本" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Visibility="{Binding Games.Count, Converter={StaticResource EmptyVisibility}}" IsHitTestVisible="False"/>
      </Grid>
      <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="22,0,0,0">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="安装配置" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,24"/>
        <TextBlock Text="Minecraft" Style="{StaticResource Caption}"/>
        <TextBlock Text="{Binding SelectedGame.Id, TargetNullValue=选择版本}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,23"/>
        <TextBlock Text="主加载器" Style="{StaticResource Caption}"/>
        <ComboBox ItemsSource="{Binding GameLoaderChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding GameLoader}" SelectionChanged="LoaderKindChanged"/>
        <StackPanel Visibility="{Binding IsFabric, Converter={StaticResource BoolVisibility}}" Margin="0,18,0,0">
         <TextBlock Text="Fabric Loader" Style="{StaticResource Caption}"/>
         <ComboBox ItemsSource="{Binding Loaders}" DisplayMemberPath="Version" SelectedItem="{Binding SelectedLoader}" SelectionChanged="LoaderSelected"/>
         <CheckBox Content="补齐 Fabric API" IsChecked="{Binding FabricApi}" Margin="0,17,0,0"/>
        </StackPanel>
        <TextBlock Text="版本名称" Style="{StaticResource Caption}" Margin="0,22,0,7"/>
        <TextBox x:Name="VersionName" Text="{Binding NewId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="新建版本名称"/>
        <Grid Margin="0,19,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="所需 Java" FontSize="12" Foreground="{DynamicResource MutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding JavaRequirement}" Foreground="{DynamicResource AccentBrush}" FontSize="12"/></Grid>
        <Button Style="{StaticResource PrimaryButton}" Click="PrepareGame" IsEnabled="{Binding CanPrepare}"><StackPanel Orientation="Horizontal"><local:Icon Kind="plus" Width="17" Height="17" Foreground="{DynamicResource AccentInkBrush}" Margin="0,0,8,0"/><TextBlock Text="创建安装计划" Foreground="{DynamicResource AccentInkBrush}"/></StackPanel></Button>
        <Button Click="DownloadGameJar" IsEnabled="{Binding CanPrepare}" Margin="0,9,0,0"><StackPanel Orientation="Horizontal"><local:Icon Kind="download" Width="16" Height="16" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0"/><TextBlock Text="仅下载客户端 JAR" FontSize="12"/></StackPanel></Button>
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,23,0,0"><StackPanel><StackPanel Orientation="Horizontal"><local:Icon Kind="shield-check" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0"/><TextBlock Text="PCL 兼容安装" FontSize="12"/></StackPanel><TextBlock Text="标准版本结构 · 文件校验" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
       </StackPanel></ScrollViewer>
      </Border>
     </Grid>
     <Grid Grid.Row="1" Visibility="{Binding IsCatalog, Converter={StaticResource BoolVisibility}}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
      <StackPanel>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="132"/><ColumnDefinition Width="10"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
        <Grid><TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchKeyDown" Padding="35,8,10,8" AutomationProperties.Name="搜索 Modrinth 内容"/><local:Icon Kind="search" Width="16" Height="16" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False"/></Grid>
        <ComboBox Grid.Column="2" ItemsSource="{Binding SortChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Sort}"/>
        <Button Grid.Column="4" Click="SearchCatalog" IsEnabled="{Binding Loading, Converter={StaticResource Not}}"><TextBlock Text="搜索"/></Button>
       </Grid>
       <WrapPanel Margin="0,10,0,16">
        <ComboBox Width="140" Margin="0,0,8,7" ItemsSource="{Binding GameFilters}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FilterGame}" ToolTip="游戏版本"/>
        <ComboBox Width="134" Margin="0,0,8,7" ItemsSource="{Binding LoaderFilters}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FilterLoader}" Visibility="{Binding ShowLoaderFilter, Converter={StaticResource BoolVisibility}}" ToolTip="加载器 / 光影平台"/>
        <ComboBox Width="136" Margin="0,0,8,7" ItemsSource="{Binding CategoryFilters}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FilterCategory}" ToolTip="内容分类"/>
        <ComboBox Width="136" Margin="0,0,8,7" ItemsSource="{Binding FeatureFilters}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FilterFeature}" Visibility="{Binding ShowExtraFilter, Converter={StaticResource BoolVisibility}}" ToolTip="内容 / 特性"/>
        <ComboBox Width="136" Margin="0,0,8,7" ItemsSource="{Binding ExtraFilters}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FilterExtra}" Visibility="{Binding ShowExtraFilter, Converter={StaticResource BoolVisibility}}" ToolTip="分辨率 / 性能影响标签"/>
       </WrapPanel>
      </StackPanel>
      <Grid Grid.Row="1">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="265"/></Grid.ColumnDefinitions>
       <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" SelectionChanged="ProjectSelected" AutomationProperties.Name="Modrinth 搜索结果">
        <ListBox.ItemTemplate><DataTemplate><Grid MinHeight="79">
         <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Border Width="48" Height="48" Background="{DynamicResource RaisedBrush}" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0" ClipToBounds="True">
          <Grid><local:Icon Kind="package" Width="24" Height="24" Foreground="{DynamicResource MutedBrush}"/><Image Source="{Binding Icon}" Stretch="UniformToFill"/></Grid>
         </Border>
         <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,0,0,5"/>
          <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxHeight="33" TextTrimming="CharacterEllipsis" LineHeight="16"/>
          <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Author}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="1" Orientation="Horizontal"><local:Icon Kind="download" Width="12" Height="12" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Downloads}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="5,0,0,0"/></StackPanel></Grid>
         </StackPanel>
        </Grid></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <TextBlock Text="没有匹配的项目" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Visibility="{Binding Projects.Count, Converter={StaticResource EmptyVisibility}}" IsHitTestVisible="False"/>
       <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="20,2,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
         <TextBlock Text="{Binding SelectedProject.Title, TargetNullValue=项目详情}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
         <TextBlock Text="{Binding SelectedProject.Description}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" MaxHeight="110" TextTrimming="CharacterEllipsis" LineHeight="19"/>
         <TextBlock Text="文件版本" Style="{StaticResource Caption}" Margin="0,23,0,7"/>
         <ComboBox ItemsSource="{Binding ProjectVersions}" SelectedItem="{Binding SelectedVersion}" DisplayMemberPath="Display" FontSize="11"/>
         <TextBlock Text="{Binding SelectedProject.Tags}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,20"/>
         <Button Style="{StaticResource PrimaryButton}" Click="PrepareContent" IsEnabled="{Binding CanPrepare}" Visibility="{Binding CanInstallCatalog, Converter={StaticResource BoolVisibility}}"><StackPanel Orientation="Horizontal"><local:Icon Kind="plus" Width="16" Height="16" Foreground="{DynamicResource AccentInkBrush}" Margin="0,0,7,0"/><TextBlock Text="创建安装计划" Foreground="{DynamicResource AccentInkBrush}" FontSize="12"/></StackPanel></Button>
         <Button Click="DownloadContent" IsEnabled="{Binding CanPrepare}" Margin="0,9,0,0"><StackPanel Orientation="Horizontal"><local:Icon Kind="download" Width="16" Height="16" Foreground="{DynamicResource MutedBrush}" Margin="0,0,7,0"/><TextBlock Text="仅下载" FontSize="12"/></StackPanel></Button>
         <Button Click="OpenProject" Margin="0,9,0,0" Background="Transparent" BorderThickness="0"><StackPanel Orientation="Horizontal"><TextBlock Text="Modrinth 项目页" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,7,0"/><local:Icon Kind="arrow-up-right" Width="14" Height="14" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Button>
         <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,15,0,16"/>
         <TextBlock Text="资源写入目录" Style="{StaticResource Caption}"/>
         <TextBlock Text="{Binding TargetDirectory}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="10" LineHeight="16"/>
        </StackPanel></ScrollViewer>
       </Border>
      </Grid>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
       <Button Click="PreviousPage" MinHeight="30" Padding="9,4" ToolTip="上一页"><local:Icon Kind="arrow-left" Width="14" Height="14" Foreground="{DynamicResource MutedBrush}"/></Button>
       <Button Click="NextPage" MinHeight="30" Padding="12,4" Margin="8,0,0,0" IsEnabled="{Binding HasNext}"><TextBlock Text="下一页" FontSize="11"/></Button>
      </StackPanel>
     </Grid>
     <Grid Grid.Row="1" Visibility="{Binding IsJava, Converter={StaticResource BoolVisibility}}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
      <StackPanel>
       <WrapPanel><ComboBox Width="135" ItemsSource="{Binding JavaMajors}" SelectedItem="{Binding JavaMajor}" ToolTip="Java 主版本" Margin="0,0,10,8"/><ComboBox Width="160" ItemsSource="{Binding JavaTypes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding JavaType}" ToolTip="Java 类型" SelectionChanged="JavaFiltersChanged" Margin="0,0,10,8"/><ComboBox Width="120" ItemsSource="{Binding InstalledChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding JavaInstalled}" SelectionChanged="JavaFiltersChanged" Margin="0,0,0,8"/></WrapPanel>
       <TextBlock Text="Windows x64" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,17,0,25"/>
       <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,23,0,0">
        <StackPanel><TextBlock Text="已安装的 Temurin" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,18"/><TextBlock Text="当前安装目录中没有 Java" FontSize="12" Foreground="{DynamicResource MutedBrush}" Visibility="{Binding InstalledJavas.Count, Converter={StaticResource EmptyVisibility}}" Margin="0,0,0,12"/><ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding InstalledJavas}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><local:Icon Kind="coffee" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel>
       </Border>
      </StackPanel>
      <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="22,2,0,0">
       <StackPanel>
        <TextBlock Text="Eclipse Temurin" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="OpenJDK · 官方发行" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,9,0,27"/>
        <TextBlock Text="安装位置" Style="{StaticResource Caption}"/><TextBlock Text="{Binding JavaDirectory}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" LineHeight="18"/>
        <Button Click="ChooseJavaDirectory" Margin="0,13,0,24"><StackPanel Orientation="Horizontal"><local:Icon Kind="folder" Width="16" Height="16" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0"/><TextBlock Text="更改位置" FontSize="12"/></StackPanel></Button>
        <Button Style="{StaticResource PrimaryButton}" Click="PrepareJava" IsEnabled="{Binding CanPrepare}"><StackPanel Orientation="Horizontal"><local:Icon Kind="plus" Width="16" Height="16" Foreground="{DynamicResource AccentInkBrush}" Margin="0,0,8,0"/><TextBlock Text="创建安装计划" Foreground="{DynamicResource AccentInkBrush}"/></StackPanel></Button>
        <Button Click="OpenJavaDirectory" Margin="0,9,0,0"><StackPanel Orientation="Horizontal"><local:Icon Kind="folder-open" Width="16" Height="16" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0"/><TextBlock Text="打开安装目录" FontSize="12"/></StackPanel></Button>
        <TextBlock Text="SHA-256 校验 · 多版本共存" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,22,0,0"/>
       </StackPanel>
      </Border>
     </Grid>
     <Grid Grid.Row="1" Visibility="{Binding IsTasks, Converter={StaticResource BoolVisibility}}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <WrapPanel Margin="0,0,0,12"><ComboBox Width="125" ItemsSource="{Binding TaskFilters}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding TaskFilter}" SelectionChanged="TaskFilterChanged" Margin="0,0,10,8"/><ComboBox Width="120" ItemsSource="{Binding TaskTypes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding TaskType}" SelectionChanged="TaskFilterChanged" Margin="0,0,10,8"/><ComboBox Width="180" ItemsSource="{Binding TaskTargets}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding TaskTarget}" SelectionChanged="TaskFilterChanged" Margin="0,0,10,8"/><Button Click="RetryPlan" IsEnabled="{Binding CanPrepare}" Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><local:Icon Kind="refresh-cw" Width="14" Height="14" Foreground="{DynamicResource MutedBrush}" Margin="0,0,7,0"/><TextBlock Text="重试所选任务" FontSize="11"/></StackPanel></Button></WrapPanel>
      <ListBox x:Name="HistoryList" Grid.Row="1" ItemsSource="{Binding History}" AutomationProperties.Name="任务记录">
       <ListBox.ItemTemplate><DataTemplate><Grid MinHeight="67"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><local:Icon Kind="download" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Target}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/><TextBlock Text="{Binding Message}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding Status}" FontSize="12"/><TextBlock Text="{Binding Time, StringFormat=MM-dd HH:mm}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Grid.Row="1" Text="暂无符合条件的任务" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Visibility="{Binding History.Count, Converter={StaticResource EmptyVisibility}}" IsHitTestVisible="False"/>
     </Grid>
     <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" Opacity=".95" Visibility="{Binding Loading, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar Width="150" IsIndeterminate="True"/><TextBlock Text="正在获取内容" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,15,0,0"/></StackPanel>
     </Border>
     <TextBlock Grid.Row="1" Text="正在解析安装计划…" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="{Binding Preparing, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,10"/>
    </Grid>
    <Border Grid.Row="3" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="26,13">
     <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="4"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
      <local:Icon Kind="download" Width="19" Height="19" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/>
      <Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ProgressTitle}" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding ProgressDetail}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="14,0,10,0" MaxWidth="390" TextTrimming="CharacterEllipsis"/></Grid>
      <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="CancelTask" ToolTip="取消当前任务" IsEnabled="{Binding Running}" Width="30" Height="30" MinHeight="30" Padding="7"><local:Icon Kind="square" Width="14" Height="14" Foreground="{DynamicResource MutedBrush}"/></Button>
      <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Value="{Binding Progress}" Maximum="100"/>
     </Grid>
    </Border>
   </Grid>
  </Grid>
  <Grid Grid.RowSpan="2" Visibility="{Binding ShowPlan, Converter={StaticResource BoolVisibility}}">
   <Border Background="#88000000" MouseDown="ClosePlanBackdrop"/>
   <Border Width="540" HorizontalAlignment="Right" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="28">
    <Grid><Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="70"/></Grid.RowDefinitions>
     <Grid><StackPanel><TextBlock Text="安装计划" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding PlanTitle}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,10,40,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button Style="{StaticResource IconButton}" Click="ClosePlan" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="关闭安装计划"><local:Icon Kind="x" Width="19" Height="19" Foreground="{DynamicResource MutedBrush}"/></Button></Grid>
     <StackPanel Grid.Row="1">
      <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="14"><TextBlock Text="{Binding PlanSummary}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" FontSize="13"/></Border>
      <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" Margin="0,18,0,12"><ItemsControl ItemsSource="{Binding PlanDetails}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,7" LineHeight="17"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      <TextBlock Text="文件清单" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,10"/>
     </StackPanel>
     <ListBox Grid.Row="2" ItemsSource="{Binding PlanFiles}">
      <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Label}" ToolTip="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="11"/><TextBlock Text="{Binding Destination}" ToolTip="{Binding Destination}" Foreground="{DynamicResource MutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/><TextBlock Text="{Binding Url}" ToolTip="{Binding Url}" Foreground="{DynamicResource MutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/><TextBlock Text="已有文件 · 确认后可能覆盖" Foreground="{DynamicResource WarningBrush}" FontSize="10" Margin="0,4,0,0" Visibility="{Binding Existing, Converter={StaticResource BoolVisibility}}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <Grid Grid.Row="3" VerticalAlignment="Bottom"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Click="ClosePlan" Content="返回"/><Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="ExecutePlan" IsEnabled="{Binding CanPrepare}"><StackPanel Orientation="Horizontal"><local:Icon Kind="download" Width="17" Height="17" Foreground="{DynamicResource AccentInkBrush}" Margin="0,0,9,0"/><TextBlock Text="确认并开始" Foreground="{DynamicResource AccentInkBrush}"/></StackPanel></Button></Grid>
    </Grid>
   </Border>
  </Grid>
 </Grid>
 </Border>
</Window>
