<Window x:Class="MineDock.App.LauncherManagerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MineDock.App"
 Title="安装启动器 · MineDock" Width="690" Height="580" MinWidth="620" MinHeight="550"
 WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{DynamicResource BackgroundBrush}"
 Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
 UseLayoutRounding="True" SnapsToDevicePixels="True" Closing="OnClosing">
 <Grid Margin="26,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22">
   <StackPanel><TextBlock Text="启动器" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="PCL / HMCL" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/></StackPanel>
   <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource IconButton}" Click="ShowLicenses" ToolTip="许可与源码" AutomationProperties.Name="许可与源码"><local:Icon Kind="shield-check" Width="18" Height="18" Foreground="{DynamicResource MutedBrush}"/></Button>
  </Grid>
  <StackPanel Grid.Row="1" Margin="0,0,0,22">
   <TextBlock Text="安装目录" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,8"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
    <TextBox x:Name="InstallDirectoryBox" Text="{Binding Directory, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding Busy}" AutomationProperties.Name="启动器安装目录"/>
    <Button x:Name="ChooseInstallDirectoryButton" Grid.Column="2" Padding="9" Click="ChooseDirectory" IsEnabled="{Binding CanInstall}" ToolTip="选择安装目录"><local:Icon Kind="folder-open" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}"/></Button>
   </Grid>
   <TextBlock Text="{Binding GameDirectory}" ToolTip="{Binding GameDirectory}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
  </StackPanel>
  <ItemsControl Grid.Row="2" ItemsSource="{Binding Packages}" IsEnabled="{Binding CanInstall}">
   <ItemsControl.ItemTemplate><DataTemplate>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="17" Margin="0,0,0,12" Height="100">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions>
      <local:Icon Kind="blocks" Width="24" Height="24" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
       <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding VersionLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
       <TextBlock Text="{Binding License}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
      </StackPanel>
      <Button Grid.Column="2" Click="InstallLauncher" Tag="{Binding Package}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Padding="10,9" AutomationProperties.Name="{Binding InstallLabel}">
       <StackPanel Orientation="Horizontal"><local:Icon Kind="download" Width="15" Height="15" Foreground="{DynamicResource AccentInkBrush}" Margin="0,0,7,0"/><TextBlock Text="安装并关联" Foreground="{DynamicResource AccentInkBrush}" FontSize="12"/></StackPanel>
      </Button>
     </Grid>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <Grid Grid.Row="3" Margin="0,10,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center">
    <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8"/>
    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
   </StackPanel>
   <Button Grid.Column="2" Click="CloseManager" Content="关闭" VerticalAlignment="Bottom"/>
  </Grid>
 </Grid>
</Window>
